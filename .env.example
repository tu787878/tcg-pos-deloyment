# Release images. Replace YOUR_GITHUB_ORGANIZATION before deployment.
APP_VERSION=1.0.0
API_IMAGE=ghcr.io/YOUR_GITHUB_ORGANIZATION/tcg-pos-api
WEB_IMAGE=ghcr.io/YOUR_GITHUB_ORGANIZATION/tcg-pos-web
POSTGRES_IMAGE=postgres:17-alpine
CERTBOT_IMAGE=certbot/certbot:v5.1.0

# Public installation identity.
DOMAIN=restaurant-one.duckdns.org
PUBLIC_URL=https://restaurant-one.duckdns.org
CORS_ALLOWED_ORIGINS=https://restaurant-one.duckdns.org
LETSENCRYPT_EMAIL=owner@example.com

# Generated by install.sh. Never commit the populated .env file.
POSTGRES_DB=simple_pos
POSTGRES_USER=simple_pos
POSTGRES_PASSWORD=GENERATED_ON_FIRST_INSTALL
DB_URL=jdbc:postgresql://postgres:5432/simple_pos
DB_USERNAME=simple_pos
DB_PASSWORD=GENERATED_ON_FIRST_INSTALL

# API runtime limits for a 4 GB server.
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
JWT_ISSUER=simple-pos-api
JWT_AUDIENCE=simple-pos-app
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D
OPENAPI_ENABLED=false
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=PT1M
SIGNUP_RATE_LIMIT_REQUESTS=5
SIGNUP_RATE_LIMIT_WINDOW=PT10M
GENERAL_RATE_LIMIT_REQUESTS=600
GENERAL_RATE_LIMIT_WINDOW=PT1M

